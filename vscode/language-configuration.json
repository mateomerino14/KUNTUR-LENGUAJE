{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {"open": "{", "close": "}"},
    {"open": "[", "close": "]"},
    {"open": "(", "close": ")"},
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]}
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\{[^}\"]*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "wordPattern": "[\\p{L}_](?:[\\p{L}\\p{N}_]|['’](?=\\p{L}))*|-?\\d+(?:\\.\\d+)?"
}
