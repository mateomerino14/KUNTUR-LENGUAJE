{
  "name": "kuntur",
  "version": "0.1.0",
  "description": "Lenguaje de programación en español que se ejecuta en el navegador",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kuntur": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p playground && tsc --noEmit -p vscode",
    "kuntur": "tsx src/cli.ts",
    "playground": "vite playground",
    "playground:build": "vite build playground",
    "vscode:build": "esbuild vscode/src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=vscode/dist/extension.cjs && esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=vscode/dist/kuntur.mjs",
    "vscode:package": "npm run vscode:build && cd vscode && vsce package --no-dependencies --skip-license --out kuntur.vsix",
    "vscode:test": "npm run vscode:build && node vscode/test/runTests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateomerino14/KUNTUR-LENGUAJE.git"
  },
  "keywords": [
    "compilador",
    "lenguaje",
    "español",
    "webassembly"
  ],
  "author": "Mateo Alejandro Merino Vidal",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@stylistic/eslint-plugin": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
